# Replace these before starting RustFS. Use unique, strong credentials.
RUSTFS_ACCESS_KEY=verbatim-rag-local
RUSTFS_SECRET_KEY=local-only-change-this-secret

# Host ports avoid colliding with other local S3 services using 9000/9001.
RUSTFS_S3_PORT=9100
RUSTFS_CONSOLE_PORT=9101

# Keep this bucket name in sync with the bucket portion of LANCEDB_URI.
RUSTFS_BUCKET=verbatim-rag

# Optional LanceDB S3 configuration for local RustFS development.
LANCEDB_URI=s3://verbatim-rag/lance-data
LANCEDB_S3_ENDPOINT=http://localhost:9100
AWS_REGION=us-east-1
